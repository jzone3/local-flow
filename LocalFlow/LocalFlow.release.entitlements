<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Entitlements for the Developer ID build, applied by the release workflow with codesign after the archive.
     Xcode refuses keychain-access-groups without a provisioning profile, which Developer ID distribution has
     none of; codesign itself accepts it. TEAM_ID is substituted by the workflow. -->
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>TEAM_ID.com.jzone3.LocalFlow</string>
	</array>
</dict>
</plist>
