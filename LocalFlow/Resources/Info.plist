	<string>Local Flow records your voice while you hold the hotkey so it can type what you said.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Local Flow pastes the transcript into the app you are using.</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio or video</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
